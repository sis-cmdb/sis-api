{
    "db" : {
        "url"  : "mongodb://localhost/sis",
        "opts" : {
            "maxPoolSize" : 10,
            "socketTimeoutMS" : 0,
            "writeConcern" : { "w" : 1, "j" : true }
        }
    },
    "server" : {
        "port" : 3000
    },
    "app" : {
        "auth" : true,
        "auth_config" : {
